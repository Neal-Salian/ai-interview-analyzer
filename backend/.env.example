DATABASE_URL=postgresql://postgres:postgres@localhost:5434/interview_db
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ANTHROPIC_API_KEY=sk-ant-your-key-here

ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_WEBHOOK_SECRET=your_zoom_webhook_secret
ZOOM_TOKEN_ENCRYPTION_KEY=your_base64_urlsafe_32_byte_key

CORS_ORIGINS=http://localhost:5173

# For Docker Mac/Windows use host.docker.internal, for local run use localhost
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=30s
